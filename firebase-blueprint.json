{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and preferences",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "fullName": { "type": "string" },
        "preferences": { "type": "object" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "createdAt"]
    },
    "Project": {
      "title": "Project",
      "description": "A project managed by the user",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string", "enum": ["F&B", "Development", "Consulting", "Personal", "Research"] },
        "status": { "type": "string", "enum": ["ACTIVE", "ON_HOLD", "COMPLETED", "CANCELLED"] },
        "budgetEstimated": { "type": "number" },
        "budgetSpent": { "type": "number" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "name", "status", "createdAt"]
    },
    "Task": {
      "title": "Task",
      "description": "A task within a project",
      "type": "object",
      "properties": {
        "projectId": { "type": "string" },
        "phaseId": { "type": "string" },
        "title": { "type": "string" },
        "description": { "type": "string" },
        "priority": { "type": "string", "enum": ["HIGH", "MEDIUM", "LOW"] },
        "status": { "type": "string", "enum": ["TODO", "IN_PROGRESS", "REVIEW", "DONE", "BLOCKED"] },
        "dueDate": { "type": "string" },
        "assignee": { "type": "string" },
        "estimatedHours": { "type": "number" },
        "actualHours": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["projectId", "title", "status", "createdAt"]
    },
    "CalendarEvent": {
      "title": "Calendar Event",
      "description": "An event in the user's calendar",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "projectId": { "type": "string" },
        "title": { "type": "string" },
        "startTime": { "type": "string" },
        "endTime": { "type": "string" },
        "location": { "type": "string" },
        "description": { "type": "string" },
        "meetingLink": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["userId", "title", "startTime", "endTime", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "User",
      "description": "User profiles"
    },
    "/users/{userId}/projects/{projectId}": {
      "schema": "Project",
      "description": "Projects belonging to the user"
    },
    "/users/{userId}/projects/{projectId}/tasks/{taskId}": {
      "schema": "Task",
      "description": "Tasks belonging to a project"
    },
    "/users/{userId}/calendarEvents/{eventId}": {
      "schema": "CalendarEvent",
      "description": "Calendar events for the user"
    }
  }
}
