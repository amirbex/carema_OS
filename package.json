{
  "name": "carema-os",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "CaReMa OS — Career & Research Manager Operating System with an AI copilot, timeline and kanban boards.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "clean": "rm -rf dist server.js"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "date-fns": "^4.4.0",
    "date-fns-jalali": "^4.4.0-0",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.15.0",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-element-popper": "^2.1.7",
    "react-markdown": "^10.1.0",
    "react-multi-date-picker": "^4.5.2",
    "react-router": "^8.0.1",
    "remark-gfm": "^4.0.1",
    "tailwindcss": "^4.1.14",
    "vite": "^6.2.3",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2"
  }
}
