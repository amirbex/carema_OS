# ---------------------------------------------------------------------------
# Server (never exposed to the browser)
# ---------------------------------------------------------------------------

# Required for the AI features (chat + voice). Without it the app still runs;
# the AI endpoints answer with a clear 503 instead of crashing.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional model overrides.
# GEMINI_MODEL="gemini-2.5-flash"
# GEMINI_LIVE_MODEL="gemini-2.0-flash-live-001"

# Port the Express server listens on (default 3000).
# PORT=3000

# APP_URL: public URL of the deployment (used for self-referential links).
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Client (Vite — must be prefixed with VITE_)
# ---------------------------------------------------------------------------

# Set to "false" to hide the shared demo-account button on the login screen.
# VITE_ENABLE_DEMO_LOGIN="true"

# Fully offline preview (GitHub Pages build): synthetic user, localStorage data
# and local AI replies. No Firebase project and no GEMINI_API_KEY needed.
# VITE_DEMO_MODE="true"

# Asset base path. Use "/<repo-name>/" for GitHub Pages, "/" everywhere else.
# VITE_BASE="/carema_OS/"
